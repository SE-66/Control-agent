{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "containers": [
    {
      "class_name": "ControlAgentContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL_AGENT",
        "class_name": "ControlAgentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlAgentContainer"]
    }
  ]
}
