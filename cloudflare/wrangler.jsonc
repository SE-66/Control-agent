{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlAgentContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ControlAgentContainer"]
    }
  ]
}
