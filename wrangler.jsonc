{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-agent",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlAgentContainer"]
    }
  ]
}
